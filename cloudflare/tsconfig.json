{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "outDir": "lib",
    "rootDir": "..",
    "strict": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "fast-xml-parser": ["node_modules/fast-xml-parser"] }
  },
  "include": ["src"]
}
