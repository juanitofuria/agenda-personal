rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Todos los datos (usuarios, eventos, programaciones, caché y horóscopos) los lee y escribe solo el servidor
    // (Cloud Functions con el SDK Admin, que ignora estas reglas). Ningún cliente tiene acceso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
